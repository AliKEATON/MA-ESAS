# ========== 数据库配置 ==========
# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ma_esas

# DuckDB
DUCKDB_PATH=./data/duckdb/analysis.duckdb

# ChromaDB
CHROMADB_PATH=./data/chromadb

# ========== API 配置 ==========
# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=True

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# ========== AI 模型配置 ==========
# 硅基流动 API
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3.2
# DeepSeek-V3.2   
# Qwen3.5-397B-A17B
# Qwen3.5-4B
# Kimi-K2.6

EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Embedding 模型
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ========== 爬虫配置 ==========
# 京东爬虫
JD_CRAWLER_TIMEOUT=30
JD_CRAWLER_RETRY_TIMES=3
JD_CRAWLER_RETRY_DELAY=5
JD_CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ========== 邮件配置 ==========
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ========== 认证配置 ==========
# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ========== 日志配置 ==========
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=500MB
LOG_RETENTION_DAYS=7

# ========== 系统配置 ==========
ENVIRONMENT=development
DEBUG=True
